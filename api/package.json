{
  "name": "lsl-booking-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev --local --port 8787 --test-scheduled",
    "migrate:local": "wrangler d1 migrations apply lsl-booking-dev --env dev --local",
    "migrate:staging": "wrangler d1 migrations apply lsl-booking-staging --env staging --remote",
    "deploy:staging": "wrangler deploy --env staging",
    "migrate:remote": "wrangler d1 migrations apply lsl-booking --remote",
    "deploy": "wrangler deploy",
    "test": "node test/run.mjs",
    "test:reservations": "node test/reservations.mjs",
    "test:past-booked": "node test/past-booked.mjs",
    "test:b2b-buffer": "node test/b2b-buffer.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
